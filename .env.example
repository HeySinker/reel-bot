TELEGRAM_BOT_TOKEN=
META_ACCESS_TOKEN=
PAGE_IDS=page_id_1,page_id_2
ALLOWED_USERS=123456789

# Vercel: استخراج الفيديو (مطلوب للإنتاج — api.cobalt.tools لم يعد مجانياً)
# الخيار 1 — RapidAPI (موصى به): https://rapidapi.com → ابحث "instagram reels downloader"
# فيسبوك (مثال):
# RAPIDAPI_KEY=
# RAPIDAPI_HOST=facebook-videos-reels-downloader.p.rapidapi.com
# RAPIDAPI_PATH=/get-video-info
# RAPIDAPI_METHOD=GET
# RAPIDAPI_URL_PARAM=url
# Vercel: خدمة resolver-service على Railway (مجاني)
# VIDEO_RESOLVER_URL=https://xxx.up.railway.app/resolve
# RESOLVER_SECRET=random_secret
# الخيار 3 — Cobalt خاص (ليس api.cobalt.tools العام)
# COBALT_API_URL=https://your-cobalt.example.com
# COBALT_API_KEY=your-api-key

# Vercel webhook (بعد النشر)
# WEBHOOK_BASE_URL=https://your-app.vercel.app
# WEBHOOK_SECRET=random_secret_string
# SETUP_SECRET=random_setup_secret

# محلي فقط — yt-dlp
# YTDLP_COOKIES_BROWSER=chrome
